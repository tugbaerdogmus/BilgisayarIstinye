@{
    ViewBag.Title = "Anasayfa";
}

<!-- Hero Section Start -->
<div class="hero">
    <div class="hero hero-bg-image parallaxie" style="background-image: url(/temaDosyalar/images/banner3-1.png); background-size: cover; background-repeat: no-repeat; background-attachment: fixed; background-position: center 0px;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="hero-content">
                        <!-- Section Title Start -->
                        <div class="section-title">
                            <h3 class="wow fadeInUp" style="visibility: visible; animation-name: fadeInUp;">Hoşgeldiniz İstinye Bilgisayar</h3>
                            <h1 class="wow fadeInUp" data-wow-delay="0.2s" data-cursor="-opaque" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeInUp;">Teknoloji ve güvenlik hizmetleri <span>MSTECH!</span></h1>
                            <p class="wow fadeInUp" data-wow-delay="0.4s" style="visibility: visible; animation-delay: 0.4s; animation-name: fadeInUp;">
                                Masaüstü ve dizüstü bilgisayarlar için bakım, onarım ve teknik destek hizmetleri sunuyoruz.
                                Bilgisayar parçaları ve güvenlik kamerası  satışı çözümleriyle, sorunu tespit eder, kalıcı ve güvenilir çözümler üretiriz.
                            </p>
                        </div>
                        <!-- Section Title End -->
                        <!-- Hero List Start -->
                        <div class="hero-list wow fadeInUp" data-wow-delay="0.6s" style="visibility: visible; animation-delay: 0.6s; animation-name: fadeInUp;">
                            <ul>
                                <li>Hızlı Teknik Destek & Onarım</li>
                                <li>Güvenilir Parça ve Çözüm</li>
                            </ul>
                        </div>
                        <!-- Hero List End -->
                        <!-- Hero Button Start -->
                        <div class="hero-btn wow fadeInUp" data-wow-delay="0.8s" style="visibility: visible; animation-delay: 0.8s; animation-name: fadeInUp;">
                            <a href="/Page/AboutUs" class="btn-default">Detayları İncele</a>
                            <a href="/Page/ContactUs" class="btn-default">İletişime Geç</a>
                        </div>
                        <!-- Hero Button End -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero Section End -->
<!-- About Us Section Start -->
@Html.Partial("_AboutUsSectionPartialView")

<!-- About Us Section End -->
<!-- Our Services Section Start -->
<div class="our-services bg-section">
    <div class="container">
        <div class="row section-row">
            <div class="col-lg-12">
                <!-- Section Title Start -->
                <div class="section-title section-title-center">
                    <h3 class="wow fadeInUp">Hizmetlerimiz</h3>
                    <h2 class="wow fadeInUp" data-wow-delay="0.2s" data-cursor="-opaque">Gelecekteki yenilikler için <span>teknolojik çözümler </span></h2>
                </div>
                <!-- Section Title End -->
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4 col-md-6">
                <!-- Service Item Start -->
                <div class="service-item wow fadeInUp">
                    <div class="icon-box">
                        <img src="/temaDosyalar/images/icon-service-1.svg" alt="">
                    </div>
                    <div class="service-item-content">
                        <h3><a href="#">Bilgisayar Teknik Servis Hizmeti</a></h3>
                        <p>MsTech İstinye Bilgisayar, masaüstü ve dizüstü bilgisayarlar için kapsamlı bilgisayar teknik servis hizmetleri sunar. Donanımsal ve yazılımsal tüm sorunlarda, cihazın gerçek ihtiyacını doğru şekilde tespit ederek kalıcı ve güvenilir çözümler üretiriz.</p>
                    </div>
                    <div class="service-btn">
                        <a href="#" class="btn-default">devamını oku</a>
                    </div>
                </div>
                <!-- Service Item End -->
            </div>

            <div class="col-lg-4 col-md-6">
                <!-- Service Item Start -->
                <div class="service-item wow fadeInUp" data-wow-delay="0.2s">
                    <div class="icon-box">
                        <img src="/temaDosyalar/images/icon-service-2.svg" alt="">
                    </div>
                    <div class="service-item-content">
                        <h3><a href="#">Web ve Yazılım Çözümleri Hizmeti</a></h3>
                        <p>MsTech İstinye Bilgisayar, işletmeler ve bireysel kullanıcılar için profesyonel web ve yazılım çözümleri sunar. İhtiyaca özel geliştirilen dijital altyapılarla, markaların online dünyada daha güçlü ve erişilebilir olmasını sağlarız.</p>
                    </div>
                    <div class="service-btn">
                        <a href="#" class="btn-default">devamını oku</a>
                    </div>
                </div>
                <!-- Service Item End -->
            </div>

            <div class="col-lg-4 col-md-6">
                <!-- Service Item Start -->
                <div class="service-item wow fadeInUp" data-wow-delay="0.4s">
                    <div class="icon-box">
                        <img src="/temaDosyalar/images/icon-service-3.svg" alt="">
                    </div>
                    <div class="service-item-content">
                        <h3><a href="#">Danışmanlık Hizmeti</a></h3>
                        <p>MsTech İstinye Bilgisayar, işletmelerin dijital süreçlerini daha verimli ve sürdürülebilir hale getirmek için danışmanlık hizmetleri sunar. Teknoloji ve dijital altyapı konularında doğru yönlendirme yaparak, işletmelerin zaman ve maliyet kaybı yaşamasını önlemeyi hedefleriz.</p>
                    </div>
                    <div class="service-btn">
                        <a href="#" class="btn-default">devamını oku</a>
                    </div>
                </div>
                <!-- Service Item End -->
            </div>



            <div class="col-lg-12">
                <!-- Section Footer Text Start -->
                <div class="section-footer-text wow fadeInUp" data-wow-delay="0.8s">
                    <p><span>Ücretsiz</span> Sizler için çözümler... <a href="#">Bizimle İletişime Geçin</a></p>
                </div>
                <!-- Section Footer Text End -->
            </div>
        </div>
    </div>
</div>
<!-- Our Services Section End -->
<!-- Our Features Section Start -->
@Html.Partial("_OzelliklerSectionView")

<!-- Our Features Section End -->
<!-- Who We Are Section Start -->
@Html.Partial("_BizKimizDetayPartialView")
<!-- Who We Are Section End -->
<!-- Our Project Section Start -->
<div class="our-project">
    <div class="container">
        <div class="row section-row align-items-center">
            <div class="col-lg-12">
                <!-- Section Title Start -->
                <div class="section-title section-title-center">
                    <h3 class="wow fadeInUp">Projelerimiz</h3>
                    <h2 class="wow fadeInUp" data-wow-delay="0.2s" data-cursor="-opaque">Teknoloji çözümlerimizi & <span>başarılı projemizi sergiliyoruz</span></h2>
                </div>
                <!-- Section Title End -->
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <!-- Project Item Start -->
                <div class="project-item wow fadeInUp">
                    <!-- Project Item Content Start -->
                    <div class="project-item-content">
                        <h3><a href="/Page/ProjectDetail?id=1">Kurumsal Bilgisayar Teknik Servis Çözümü</a></h3>
                        <p>
                            Kurumsal bir işletme için bilgisayar ve laptop teknik servis hizmeti sağlandı.
                            Sistem bakımı, onarım ve performans iyileştirme işlemleri başarıyla tamamlandı.
                        </p>
                    </div>
                    <!-- Project Item Content End -->
                    <!-- Project Image Start -->
                    <div class="project-image">
                        <a href="#" data-cursor-text="View">
                            <figure class="image-anime">
                                <img src="/temaDosyalar/images/proje1.png" alt="">
                            </figure>
                        </a>
                    </div>
                    <!-- Project Image End -->
                </div>
                <!-- Project Item End -->
            </div>

            <div class="col-md-6">
                <!-- Project Item Start -->
                <div class="project-item wow fadeInUp" data-wow-delay="0.2s">
                    <!-- Project Item Content Start -->
                    <div class="project-item-content">
                        <h3><a href="/Page/ProjectDetail?id=1">Dijital Altyapı & Teknik Destek Projesi</a></h3>
                        <p>
                            Bir işletme için web sitesi kurulumu ve yazılım altyapısı oluşturuldu.
                            Teknik destek, güncelleme ve sistem optimizasyonu süreçleri sağlandı.
                        </p>
                    </div>
                    <!-- Project Item Content End -->
                    <!-- Project Image Start -->
                    <div class="project-image">
                        <a href="#" data-cursor-text="View">
                            <figure class="image-anime">
                                <img src="/temaDosyalar/images/proje2.png" alt="">
                            </figure>
                        </a>
                    </div>
                    <!-- Project Image End -->
                </div>
                <!-- Project Item End -->
            </div>
        </div>
    </div>
</div>
<!-- Our Project Section End -->

